SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# JWT secret from Supabase project Settings → API → JWT Secret
# Required when ENVIRONMENT=production — app refuses to start without it
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
GOOGLE_AI_STUDIO_KEY=your-google-ai-studio-key
ANTHROPIC_API_KEY=your-anthropic-api-key
APIFY_API_KEY=your-apify-api-key
REMOTION_URL=http://localhost:3100
# Shared secret between backend and remotion-service for /render endpoint auth
# Required when ENVIRONMENT=production — app refuses to start without it
REMOTION_SECRET=your-remotion-secret
ENVIRONMENT=development
